<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>BotBBVA.Panel</RootNamespace>
    <AssemblyName>BotBBVA.Panel</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\logoBBVA.png" />
    <Resource Include="Assets\logoBBVA.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BotBBVA.Contratos\BotBBVA.Contratos.csproj" />
  </ItemGroup>

</Project>
