<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Colores semánticos de la aplicación (sobre el tema Fluent).
         Los colores de superficie, texto y acento provienen del tema
         WPF UI; aquí solo se definen los matices propios del dominio.
         ============================================================ -->

    <!-- Niveles de log (paleta Fluent oscura) -->
    <SolidColorBrush x:Key="Brocha.Nivel.Informacion" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="Brocha.Nivel.Exito" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="Brocha.Nivel.Advertencia" Color="#FCE100"/>
    <SolidColorBrush x:Key="Brocha.Nivel.Error" Color="#FF99A4"/>

    <!-- Estados del bot -->
    <SolidColorBrush x:Key="Brocha.EstadoBot.Detenido" Color="#9AA7B5"/>
    <SolidColorBrush x:Key="Brocha.EstadoBot.Iniciado" Color="#6CCB5F"/>

    <!-- Estados de ejecución -->
    <SolidColorBrush x:Key="Brocha.EstadoEjecucion.Detenido" Color="#9AA7B5"/>
    <SolidColorBrush x:Key="Brocha.EstadoEjecucion.FueraDeHorario" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="Brocha.EstadoEjecucion.Ejecutando" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="Brocha.EstadoEjecucion.Deteniendo" Color="#FCE100"/>

    <!-- Estados de las etapas del proceso -->
    <SolidColorBrush x:Key="Brocha.Etapa.Pendiente" Color="#5A6B7D"/>
    <SolidColorBrush x:Key="Brocha.Etapa.EnCurso" Color="#2DCCCD"/>
    <SolidColorBrush x:Key="Brocha.Etapa.Completado" Color="#6CCB5F"/>

    <!-- Estados del servicio y dependencias -->
    <SolidColorBrush x:Key="Brocha.Servicio.Conectado" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="Brocha.Servicio.Desconectado" Color="#FF99A4"/>

</ResourceDictionary>
