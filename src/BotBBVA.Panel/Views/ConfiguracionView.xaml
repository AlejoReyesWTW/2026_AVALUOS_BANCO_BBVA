<UserControl x:Class="BotBBVA.Panel.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:BotBBVA.Panel.Converters">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer DataContext="{Binding Configuracion}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24" MaxWidth="840" HorizontalAlignment="Center">

            <!-- Cabecera con botón Atrás -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:Button Content="Atrás" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowLeft24}" FontSize="14"
                           Command="{Binding VolverCommand}"/>
                <TextBlock Grid.Column="1" Text="Configuración"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontSize="28" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <!-- Ventana de ejecución -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Margin="0,0,0,16">
                <StackPanel Margin="18,14,18,16">
                    <TextBlock Text="Ventana de ejecución" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="17"/>

                    <TextBlock Text="{Binding MensajeAyudaHorario}"
                               Foreground="{StaticResource Brocha.Nivel.Advertencia}"
                               FontSize="14" Margin="0,8,0,0"
                               Visibility="{Binding CamposHorarioBloqueados, Converter={StaticResource BoolToVis}}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Hora de inicio (HH:mm)" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBox Width="150" Margin="0,6,0,0" FontSize="18" TextAlignment="Center"
                                     Text="{Binding HoraInicioTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding HorarioEditable}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="Hora de fin (HH:mm)" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBox Width="150" Margin="0,6,0,0" FontSize="18" TextAlignment="Center"
                                     Text="{Binding HoraFinTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding HorarioEditable}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="Se admiten ventanas que cruzan medianoche (por ejemplo 20:00–06:00)."
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="14" TextWrapping="Wrap" Width="300" Margin="28,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Archivos por lote -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Margin="0,0,0,16">
                <StackPanel Margin="18,14,18,16">
                    <TextBlock Text="Archivos por lote (DocLM)" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="17"/>

                    <TextBlock Text="Los rangos de páginas son fijos. Solo se edita la cantidad de archivos por lote (1–5); el rango >200 permanece en 0."
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <ItemsControl ItemsSource="{Binding Rangos}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Edit24" FontSize="15" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding EsEditable, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Etiqueta}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="16"/>
                                        <TextBlock Text="páginas" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="2" Width="70" TextAlignment="Center" FontSize="16"
                                             Text="{Binding ArchivosPorLote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding EsEditable}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Credenciales DocLM -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Margin="0,0,0,16">
                <StackPanel Margin="18,14,18,16">
                    <TextBlock Text="Credenciales DocLM" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="17"/>
                    <TextBlock Text="Datos de autenticación OAuth2 (client credentials). Quedan ocultos; usá el ojo para verlos y se guardan al pulsar Guardar."
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="tenant_id" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" BorderThickness="1" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TenantIdTexto}" Value="">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brocha.Nivel.Error}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:PasswordBox FontSize="14" RevealButtonEnabled="True"
                                            Password="{Binding TenantIdTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="client_id" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" BorderThickness="1" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClientIdTexto}" Value="">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brocha.Nivel.Error}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:PasswordBox FontSize="14" RevealButtonEnabled="True"
                                            Password="{Binding ClientIdTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="client_secret" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" BorderThickness="1" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClientSecretTexto}" Value="">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brocha.Nivel.Error}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:PasswordBox FontSize="14" RevealButtonEnabled="True"
                                            Password="{Binding ClientSecretTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="scope" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" FontSize="14"
                                 Text="{Binding ScopeTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Endpoints -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Margin="0,0,0,16">
                <StackPanel Margin="18,14,18,16">
                    <TextBlock Text="Endpoints" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="17"/>

                    <TextBlock Text="URLs externas que usa el bot."
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <ItemsControl ItemsSource="{Binding Endpoints}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent"
                                               Command="{Binding EditarCommand}" ToolTip="Editar"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding Metodo}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Nombre}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBox Margin="0,2,0,0" FontSize="13"
                                                 Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding EsSoloLectura}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Tiempo de espera entre consultas -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent"
                                   Command="{Binding EditarIntervaloCommand}" ToolTip="Editar" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Tiempo de espera entre consultas:" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Width="70" TextAlignment="Center" FontSize="14" Margin="10,0,0,0"
                                 Text="{Binding IntervaloConsultaTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IntervaloEsSoloLectura}"/>
                        <TextBlock Grid.Column="3" Text="segundos" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Tiempo que el bot espera antes de volver a consultar el estado de un documento o assessment mientras su state siga en 'pending'."
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Guardar -->
            <ui:Button Content="Guardar" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" FontSize="15"
                       Command="{Binding GuardarCommand}" HorizontalAlignment="Center"
                       IsEnabled="{Binding HayCambiosSinGuardar}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
