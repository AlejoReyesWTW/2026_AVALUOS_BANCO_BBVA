<UserControl x:Class="BotBBVA.Panel.Views.PanelPrincipalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:BotBBVA.Panel.Converters">

    <UserControl.Resources>
        <conv:EnumToBrushConverter x:Key="EnumToBrush"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="IndicadorTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,16,24,24">

            <!-- ============================================
                 Cabecera: título y acciones
                 ============================================ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Estado del bot"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Monitoreo en tiempo real del procesamiento de documentos"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="13" Margin="0,4,0,0"/>
                    <TextBlock Text="Vaya a Configuración y establezca las variables de funcionamiento del bot."
                               Foreground="{StaticResource Brocha.Nivel.Error}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                               Visibility="{Binding FaltanCredenciales, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Iniciar bot"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Play24}"
                               Command="{Binding IniciarCommand}"
                               Visibility="{Binding BotDetenido, Converter={StaticResource BoolToVis}}"
                               ToolTip="Vaya a Configuración y establezca las variables de funcionamiento del bot."
                               ToolTipService.ShowOnDisabled="True"
                               Margin="0,0,8,0"/>
                    <ui:Button Content="Detener bot"
                               Appearance="Danger"
                               Icon="{ui:SymbolIcon Stop24}"
                               Command="{Binding DetenerCommand}"
                               Visibility="{Binding BotIniciado, Converter={StaticResource BoolToVis}}"
                               Margin="0,0,8,0"/>
                    <ui:Button Content="Abrir Excel"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding AbrirExcelCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ============================================
                 Indicadores principales
                 ============================================ -->
            <UniformGrid Columns="5" Margin="0,0,0,12">
                <Border Style="{StaticResource IndicadorTile}">
                    <StackPanel>
                        <TextBlock Text="SERVICIO" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding TextoEstadoServicio}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brocha.Servicio.Conectado}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource IndicadorTile}">
                    <StackPanel>
                        <TextBlock Text="ESTADO DEL BOT" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding TextoEstadoBot}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{Binding EstadoBot, Converter={StaticResource EnumToBrush}, ConverterParameter=Brocha.EstadoBot.}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource IndicadorTile}">
                    <StackPanel>
                        <TextBlock Text="ESTADO DE EJECUCIÓN" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding TextoEstadoEjecucion}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{Binding EstadoEjecucion, Converter={StaticResource EnumToBrush}, ConverterParameter=Brocha.EstadoEjecucion.}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource IndicadorTile}">
                    <StackPanel>
                        <TextBlock Text="PENDIENTES" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Pendientes, StringFormat={}{0:N0}}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource IndicadorTile}">
                    <StackPanel>
                        <TextBlock Text="EN PROCESAMIENTO" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding EnProcesamiento}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource IndicadorTile}">
                    <StackPanel>
                        <TextBlock Text="PROCESADOS DEL DÍA" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding ProcesadosDelDia, StringFormat={}{0:N0}}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource IndicadorTile}">
                    <StackPanel>
                        <TextBlock Text="TOTAL PROCESADOS" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding TotalProcesados, StringFormat={}{0:N0}}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource IndicadorTile}">
                    <StackPanel>
                        <TextBlock Text="HORA DE INICIO" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding TextoHoraInicio}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource IndicadorTile}">
                    <StackPanel>
                        <TextBlock Text="ÚLTIMA EJECUCIÓN" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding TextoHoraUltimaEjecucion}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource IndicadorTile}">
                    <StackPanel>
                        <TextBlock Text="TIEMPO DE EJECUCIÓN" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding TextoTiempoEjecucion}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================================
                 Contadores del día
                 ============================================ -->
            <UniformGrid Columns="5" Margin="0,0,0,12">
                <ui:CardControl Margin="0,0,8,0">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource Brocha.Nivel.Exito}" FontSize="14"/>
                            <TextBlock Text="Actualizados" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <TextBlock Text="{Binding Contadores.Actualizados}" Foreground="{StaticResource Brocha.Nivel.Exito}" FontSize="26" FontWeight="SemiBold"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,8,0">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" Foreground="{StaticResource Brocha.Nivel.Informacion}" FontSize="14"/>
                            <TextBlock Text="Sin datos" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <TextBlock Text="{Binding Contadores.SinDatos}" Foreground="{StaticResource Brocha.Nivel.Informacion}" FontSize="26" FontWeight="SemiBold"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,8,0">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource Brocha.Nivel.Advertencia}" FontSize="14"/>
                            <TextBlock Text="Sin ruta" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <TextBlock Text="{Binding Contadores.SinRuta}" Foreground="{StaticResource Brocha.Nivel.Advertencia}" FontSize="26" FontWeight="SemiBold"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,8,0">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentSearch24" Foreground="{StaticResource Brocha.Nivel.Advertencia}" FontSize="14"/>
                            <TextBlock Text="Excluidos (>200)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <TextBlock Text="{Binding Contadores.ExcluidosPorPaginas}" Foreground="{StaticResource Brocha.Nivel.Advertencia}" FontSize="26" FontWeight="SemiBold"/>
                </ui:CardControl>

                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="{StaticResource Brocha.Nivel.Error}" FontSize="14"/>
                            <TextBlock Text="Errores" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <TextBlock Text="{Binding Contadores.Errores}" Foreground="{StaticResource Brocha.Nivel.Error}" FontSize="26" FontWeight="SemiBold"/>
                </ui:CardControl>
            </UniformGrid>

            <!-- ============================================
                 Estado y progreso por etapas
                 ============================================ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Estado y progreso del procesamiento" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="18,14,18,0"/>
                    <ItemsControl ItemsSource="{Binding Etapas}" HorizontalContentAlignment="Stretch" Margin="18,10,18,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3,0">
                                    <Border Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Center"
                                            Background="{Binding Estado, Converter={StaticResource EnumToBrush}, ConverterParameter=Brocha.Etapa.}">
                                        <TextBlock Text="{Binding Numero}" Foreground="#043263" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Etiqueta}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============================================
                 Contexto del lote en curso
                 ============================================ -->
            <ui:CardControl Margin="0,0,0,12" Visibility="{Binding HayLoteEnCurso, Converter={StaticResource BoolToVis}}">
                <ui:CardControl.Header>
                    <TextBlock Text="Lote en curso" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                </ui:CardControl.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="ID TAREA" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding ContextoActual.IdTarea}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock Text="RANGO" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding ContextoActual.RangoEtiqueta}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,24,0">
                        <TextBlock Text="ARCHIVOS / CAPACIDAD" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="{Binding ContextoActual.ArchivosLote}"/><Run Text=" / "/><Run Text="{Binding ContextoActual.CapacidadLote}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,24,0">
                        <TextBlock Text="TIEMPO" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding ContextoActual.TiempoTranscurrido}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="DOCUMENTOS" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding ContextoActual.Documentos}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </ui:CardControl>

            <!-- ============================================
                 Dependencias
                 ============================================ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Dependencias" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="18,14,18,0"/>
                    <UniformGrid Columns="3" Margin="18,10,18,14">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Database24" FontSize="18" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{StaticResource Brocha.Nivel.Error}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DependenciaSql.Disponible}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brocha.Nivel.Exito}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DependenciaSql.Nombre}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding DependenciaSql.TextoDisponible}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                </StackPanel>
                                <Ellipse Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Brocha.Nivel.Error}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DependenciaSql.Disponible}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brocha.Nivel.Exito}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <ui:Button Content="Probar conexión" Appearance="Secondary" Icon="{ui:SymbolIcon PlugConnected24}"
                                       Command="{Binding ProbarConexionCommand}" CommandParameter="{Binding DependenciaSql}"
                                       Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
                            <Border Margin="0,10,0,0" Padding="10,6" CornerRadius="6"
                                    Visibility="{Binding DependenciaSql.MostrarMensaje, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#33FF99A4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DependenciaSql.Disponible}" Value="True">
                                                <Setter Property="Background" Value="#336CCB5F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DependenciaSql.UltimoMensaje}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Server24" FontSize="18" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{StaticResource Brocha.Nivel.Error}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DependenciaArchivos.Disponible}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brocha.Nivel.Exito}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DependenciaArchivos.Nombre}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding DependenciaArchivos.TextoDisponible}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                </StackPanel>
                                <Ellipse Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Brocha.Nivel.Error}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DependenciaArchivos.Disponible}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brocha.Nivel.Exito}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <ui:Button Content="Probar conexión" Appearance="Secondary" Icon="{ui:SymbolIcon PlugConnected24}"
                                       Command="{Binding ProbarConexionCommand}" CommandParameter="{Binding DependenciaArchivos}"
                                       Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
                            <Border Margin="0,10,0,0" Padding="10,6" CornerRadius="6"
                                    Visibility="{Binding DependenciaArchivos.MostrarMensaje, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#33FF99A4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DependenciaArchivos.Disponible}" Value="True">
                                                <Setter Property="Background" Value="#336CCB5F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DependenciaArchivos.UltimoMensaje}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Cloud24" FontSize="18" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{StaticResource Brocha.Nivel.Error}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DependenciaDocLm.Disponible}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brocha.Nivel.Exito}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DependenciaDocLm.Nombre}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding DependenciaDocLm.TextoDisponible}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                </StackPanel>
                                <Ellipse Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Brocha.Nivel.Error}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DependenciaDocLm.Disponible}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brocha.Nivel.Exito}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <ui:Button Content="Probar conexión" Appearance="Secondary" Icon="{ui:SymbolIcon PlugConnected24}"
                                       Command="{Binding ProbarConexionCommand}" CommandParameter="{Binding DependenciaDocLm}"
                                       Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
                            <Border Margin="0,10,0,0" Padding="10,6" CornerRadius="6"
                                    Visibility="{Binding DependenciaDocLm.MostrarMensaje, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#33FF99A4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DependenciaDocLm.Disponible}" Value="True">
                                                <Setter Property="Background" Value="#336CCB5F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DependenciaDocLm.UltimoMensaje}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ============================================
                 Log de conectividad
                 ============================================ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Margin="0,16,0,12">
                <StackPanel>
                    <ui:Button Appearance="Transparent" HorizontalAlignment="Left" Margin="18,10,18,0" Padding="0"
                               Command="{Binding AlternarLogConectividadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="14" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="ChevronDown24"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LogConectividadVisible}" Value="False">
                                                <Setter Property="Symbol" Value="ChevronRight24"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="Log de conectividad" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ui:Button>
                    <Border CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" ClipToBounds="True" Margin="18,10,18,14"
                            Visibility="{Binding LogConectividadVisible, Converter={StaticResource BoolToVis}}">
                        <ListView ItemsSource="{Binding LogConectividad}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Margin="6"
                                  FontFamily="Consolas"
                                  FontSize="12"
                                  MaxHeight="140"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Hora}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding EtiquetaNivel}"
                                                   Foreground="{Binding Nivel, Converter={StaticResource EnumToBrush}, ConverterParameter=Brocha.Nivel.}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Mensaje}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================
                 Log detallado
                 ============================================ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10">
                <StackPanel>
                    <Grid Margin="18,14,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Appearance="Transparent" HorizontalAlignment="Left" Padding="0"
                                   Command="{Binding AlternarLogDetalladoCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="14" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronDown24"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LogDetalladoVisible}" Value="False">
                                                    <Setter Property="Symbol" Value="ChevronRight24"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock Text="Log detallado" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="10,0,0,0"
                                                 Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <TextBlock Grid.Column="1" Text="{Binding Log.Count, StringFormat={}{0} entradas}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>

                    <Border CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" ClipToBounds="True" Margin="18,10,18,14"
                            Visibility="{Binding LogDetalladoVisible, Converter={StaticResource BoolToVis}}">
                        <ListView x:Name="ListaLog"
                                  ItemsSource="{Binding Log}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Margin="6"
                                  FontFamily="Consolas"
                                  FontSize="12"
                                  MaxHeight="360"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Hora}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding EtiquetaNivel}"
                                                   Foreground="{Binding Nivel, Converter={StaticResource EnumToBrush}, ConverterParameter=Brocha.Nivel.}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding EtiquetaRegistro}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Documento}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="4" Text="{Binding EtiquetaEstado}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Mensaje}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
